# API BLITZ 2026 - Hackathon Environment Template
# Copy this file to .env and fill in your keys

# 1. NASA Open API (Get your key at https://api.nasa.gov)
VITE_NASA_API_KEY=your_nasa_api_key_here

# 2. Open-Meteo Weather & Solar Radiation API Key
VITE_OPEN_METEO_API_KEY=your_open_meteo_key_here

# 3. Nominatim OpenStreetMap Geocoding Key
VITE_NOMINATIM_API_KEY=your_nominatim_key_here

# 4. REST Countries API Key
VITE_REST_COUNTRIES_API_KEY=your_rest_countries_key_here

# 5. Wikipedia REST Knowledge API Key
VITE_WIKIPEDIA_API_KEY=your_wikipedia_key_here
